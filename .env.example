# ============== BROKER CREDENTIALS ==============
# Alpaca (RECOMMENDED — has an official API + free paper trading)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Use https://paper-api.alpaca.markets for paper, https://api.alpaca.markets for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Robinhood (UNOFFICIAL — handle with care, 2FA required)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_CODE=          # leave empty; will be prompted at runtime

# ============== DATA APIs ==============
POLYGON_API_KEY=             # optional — used for market data (data.provider=polygon) AND news
FINNHUB_API_KEY=             # optional — fallback news source (add "finnhub" to signals.sentiment.sources)
NEWSAPI_KEY=                 # optional — fallback news source (add "newsapi" to signals.sentiment.sources)
# Note: Alpaca news uses ALPACA_API_KEY / ALPACA_API_SECRET above — no extra key needed
# Note: StockTwits requires NO API key (free tier, 200 req/hr; bot caches results for 5 min)

# ============== NOTIFICATIONS (optional) ==============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# ============== LOGGING ==============
LOG_LEVEL=INFO
